case 'listgc': {
    let adminIDs;
    try {
        adminIDs = JSON.parse(fs.readFileSync(adminfile, 'utf8'));
    } catch (err) {
        console.error('Error reading adminID.json:', err);
        return sam.reply('Failed to load admin data.');
    }

    const userID = sam.message.from.id.toString();
    if (!Array.isArray(adminIDs) || !adminIDs.includes(userID)) {
        return sam.reply(`You are not authorized to use this command.`);
    }

    if (!text) {
        return sam.reply(`Usage: ${prefix + command} <paired_number>\nExample: ${prefix + command} 447346678875`);
    }

    const targetNumber = text.replace(/[^0-9]/g, '').trim();
    const gcCachePath = `./lib2/pairing/groups_cache_${targetNumber}.json`;

    try {
        if (!fs.existsSync(gcCachePath)) {
            return sam.reply(`❌ No active group cache found for ${targetNumber}.`);
        }

        const groupsData = JSON.parse(fs.readFileSync(gcCachePath, 'utf-8'));
        if (groupsData.length === 0) {
            return sam.reply(`No group chats were found associated with ${targetNumber}.`);
        }

        const itemsPerPage = 10;
        const totalGroups = groupsData.length;
        const totalPages = Math.ceil(totalGroups / itemsPerPage);
        const currentPage = 1;

        const startIdx = 0;
        const pageItems = groupsData.slice(startIdx, itemsPerPage);

        let txt = `🌐 *WhatsApp Group List (${targetNumber})*\n`;
        txt += `📑 *Page:* ${currentPage} / ${totalPages} | 👥 *Total Groups:* ${totalGroups}\n`;
        txt += `───────────────────\n\n`;

        pageItems.forEach((gc, i) => {
            txt += `${i + 1}. *Name:* ${gc.subject}\n   *JID:* \`${gc.id}\`\n\n`;
        });

        // Build navigation buttons dynamically
        const buttons = [];
        if (totalPages > 1) {
            buttons.push(Markup.button.callback('➡️ Next Page', `listpage ${targetNumber} 2 ${userID}`));
        }

        // Telegraf requires inline buttons to be wrapped in an array of arrays (e.g., [[button1, button2]])
        return await sam.replyWithMarkdown(txt, Markup.inlineKeyboard([buttons]));
    } catch (err) {
        console.error(err);
        return sam.reply("❌ Failed to process group dataset query.");
    }
}
break;

case 'listpage': {
    // action[1] = targetNumber, action[2] = requestedPage, action[3] = structuralUserID
    const targetNumber = action[1];
    let page = parseInt(action[2]);
    const originalSenderId = action[3];

    // Security check: Only allow the user who ran the command to click the buttons
    if (leo.callbackQuery.from.id.toString() !== originalSenderId) {
        return leo.answerCbQuery('❌ This menu belongs to someone else!', { show_alert: true });
    }

    const gcCachePath = `./lib2/pairing/groups_cache_${targetNumber}.json`;
    if (!fs.existsSync(gcCachePath)) {
        return leo.answerCbQuery('❌ Cache file missing. Run command again.', { show_alert: true });
    }

    const groupsData = JSON.parse(fs.readFileSync(gcCachePath, 'utf-8'));
    const itemsPerPage = 10;
    const totalGroups = groupsData.length;
    const totalPages = Math.ceil(totalGroups / itemsPerPage);

    const startIdx = (page - 1) * itemsPerPage;
    const pageItems = groupsData.slice(startIdx, startIdx + itemsPerPage);

    let txt = `🌐 *WhatsApp Group List (${targetNumber})*\n`;
    txt += `📑 *Page:* ${page} / ${totalPages} | 👥 *Total Groups:* ${totalGroups}\n`;
    txt += `───────────────────\n\n`;

    pageItems.forEach((gc, i) => {
        const absoluteIndex = startIdx + i + 1;
        txt += `${absoluteIndex}. *Name:* ${gc.subject}\n   *JID:* \`${gc.id}\`\n\n`;
    });

    // Build responsive Row layout buttons
    const row = [];
    if (page > 1) {
        row.push(Markup.button.callback('⬅️ Back', `listpage ${targetNumber} ${page - 1} ${originalSenderId}`));
    }
    if (page < totalPages) {
        row.push(Markup.button.callback('➡️ Next', `listpage ${targetNumber} ${page + 1} ${originalSenderId}`));
    }

    try {
        // Edit the message content and inline buttons smoothly in place
        await leo.editMessageText(txt, {
            parse_mode: 'Markdown',
            ...Markup.inlineKeyboard(row)
        });
        await leo.answerCbQuery();
    } catch (err) {
        console.error(err);
    }
}
