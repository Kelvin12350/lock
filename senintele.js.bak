function generateRandomPassword() {
  const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#%^&*';
  const length = 10;
  let password = '';
  for (let i = 0; i < length; i++) {
    const randomIndex = Math.floor(Math.random() * characters.length);
    password += characters[randomIndex];
  }
  return password;
}       


async function sendMustJoinMessage(botInstance, chatId) {
  const msg = await botInstance.sendMessage(
    chatId,
    `🚫 *Access Locked*\n\n` +
    `You must join both channels to use this bot:\n\n` +
    `1️⃣ Bot Support Channel\n` +
    `2️⃣ BOT SUPPORT GROUP\n\n` +
    `⏳ This message will disappear in 1 minute.\n` +
    `After joining, type /menu`,
    { parse_mode: 'Markdown' }
  );

  setTimeout(() => {
    botInstance.deleteMessage(chatId, msg.message_id).catch(() => {});
  }, 30 * 1000);
}
// 🔐 Check if user joined all required channels
async function isUserJoinedAll(bot, userId) {
  const REQUIRED_CHANNELS = [
  '@kingsamzone',
  '@kingsamzone'
];

  for (const channel of REQUIRED_CHANNELS) {
    try {
      const member = await bot.getChatMember(channel, userId);
      if (member.status === 'left' || member.status === 'kicked') {
        return false;
      }
    } catch (err) {
      return false; // bot not admin or channel error
    }
  }
  return true;
}
