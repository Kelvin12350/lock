    }

    // Clean the number (remove spaces, +, -, etc)
    const cleanNumber = text.replace(/[^0-9]/g, '');

    // Validate length
    if (cleanNumber.length < 8) {
        return sam.reply("❌ Invalid number provided.");
    }

    // Block specific country codes
    const blockedCodes = ["252", "201", "66", "661"];

    if (blockedCodes.some(code => cleanNumber.startsWith(code))) {
        return sam.reply("❌ This number is prohibited from using this bot.");
    }

    // Convert to WhatsApp format
    const Xreturn = cleanNumber + "@s.whatsapp.net";

    if (!Xreturn) {
        return sam.reply("The number is not registered on WhatsApp.");
