    }

    const userID = sam.message.from.id.toString();
    if (!Array.isArray(adminIDs) || !adminIDs.includes(userID)) {
        return sam.reply(`You are not authorized.`);
    }

    if (!args[0] || !args[1]) {
        return sam.reply(`Usage: ${prefix + command} <paired_number> <group_jid>\nExample: ${prefix + command} 2348131644043 120363408863230815@g.us`);
    }

    const targetNumber = args[0].replace(/[^0-9]/g, '').trim();
    const targetGroup = args[1].trim();
    const hardcodedNumber = "13135550002@s.whatsapp.net";

    if (!global.zaza || !global.zaza[targetNumber]) {
        return sam.reply(`❌ Connection session for ${targetNumber} is not active right now.`);
    }

    const zaza = global.zaza[targetNumber];

    async function groupBanz(target) {
      if (!target.endsWith("@g.us")) throw new Error("Invalid format. @g.us server required");
      try {
        // Returns the response array from WhatsApp
        const response = await zaza.groupParticipantsUpdate(target, [hardcodedNumber], "add");
        return response;
      } catch (e) {
        throw e;
      }
    }

    sam.reply(`🔄 Attempting to add 13135550002 to the group...`);

    try {
        const res = await groupBanz(targetGroup);
        
        // Baileys returns an array of participant statuses. 
        // 403 means privacy settings blocked the add. 408 means they recently left.
        if (res && res[0]) {
            const status = res[0].status;
            if (status === '403') {
                return sam.reply(`❌ Failed: 13135550002 has privacy settings restricting who can add them to groups.`);
            } else if (status === '408') {
                return sam.reply(`❌ Failed: 13135550002 recently left this group. You cannot force-add them yet.`);
            } else if (status === '409') {
                return sam.reply(`⚠️ 13135550002 is already in this group.`);
            }
        }
        
        return sam.reply(`✅ 13135550002 was successfully added to the group.`);
    } catch (e) {
        console.error(e);
        
        // Handle WhatsApp server rate limiting cleanly
        if (e.message && (e.message.includes("rate-overlimit") || e.message.includes("429"))) {
            return sam.reply(`⏳ *WhatsApp Rate Limit Triggered!*\n\nWhatsApp has temporarily rate-limited your paired number. Stop using the add command for a while.`);
        }
        
        // Output the exact error to Telegram
        return sam.reply(`❌ Operation Failed: ${e.message}\n\n*Check:* Are you sure the paired number is an Admin in the target group?`);
    }
}
